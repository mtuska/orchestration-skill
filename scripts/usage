#!/usr/bin/env python3
"""usage: plan-quota snapshot for Claude (claude.ai OAuth), Codex (ChatGPT), Gemini (Antigravity) and Cursor in one JSON.

Companion to the orchestration skill. Read-only, stdlib only.
Checks claude, codex, agy and cursor-agent on PATH before reading quotas.
Missing CLIs are reported as not_installed and excluded from routing.

  usage                 # JSON for every vendor, with a routing hint
  usage --text          # short human summary
  usage --vendor codex  # one vendor
  usage --no-refresh    # disable Claude/Grok token refresh
  usage --no-cache      # bypass the 15-minute cache

Exit 0 when at least one vendor was read; 2 when none could be read.
"""
import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import datetime as dt
import fcntl
import glob
import json
import math
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "orchestration-usage")
CACHE_FILE = os.path.join(CACHE_DIR, "last.json")
CACHE_LOCK = os.path.join(CACHE_DIR, "last.lock")
CACHE_TTL = 15 * 60
FAILURE_TTL = 60
CACHE_VERSION = 8
CLAUDE_CREDS = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude")), ".credentials.json")
CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CODEX_HOME = os.environ.get("CODEX_HOME", os.path.join(HOME, ".codex"))

PACE_YELLOW = 1.3  # 30% above expected consumption at this point in the window
PACE_RED = 1.5     # 50% above expected consumption


def now_utc():
    return dt.datetime.now(dt.timezone.utc)


def iso(d):
    return d.astimezone(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_ts(v):
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return dt.datetime.fromtimestamp(v if v < 1e11 else v / 1000, dt.timezone.utc)
    try:
        return dt.datetime.fromisoformat(str(v).replace("Z", "+00:00"))
    except ValueError:
        return None


def human_delta(secs):
    if secs is None:
        return None
    secs = max(0, int(secs))
    d, r = divmod(secs, 86400)
    h, r = divmod(r, 3600)
    m = r // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m}m"
    return f"{m}m"


def window(wid, label, percent, resets_at, duration_s, active=None, extra=None):
    """Normalise one quota window and compute pace against elapsed time."""
    now = now_utc()
    w = {"id": wid, "label": label, "percent": None if percent is None else round(float(percent), 1),
         "resets_at": iso(resets_at) if resets_at else None,
         "resets_in": human_delta((resets_at - now).total_seconds()) if resets_at else None,
         "window_hours": round(duration_s / 3600, 1) if duration_s else None,
         "expected_percent_now": None, "pace_ratio": None, "pace": "n/a"}
    if active is not None:
        w["is_active"] = bool(active)
    if percent is not None and resets_at and duration_s:
        start = resets_at - dt.timedelta(seconds=duration_s)
        frac = (now - start).total_seconds() / duration_s
        frac = min(1.0, max(0.0, frac))
        expected = frac * 100
        w["expected_percent_now"] = round(expected, 1)
        if expected >= 2:
            ratio = float(percent) / expected
            w["pace_ratio"] = round(ratio, 2)
            w["pace"] = "ahead" if ratio > 1.1 else ("behind" if ratio < 0.9 else "on")
    if extra:
        w.update(extra)
    return w


def level_for(windows, hard_stop=False):
    if hard_stop:
        return "red"
    levels = []
    for w in windows:
        p = w.get("percent")
        ratio = w.get("pace_ratio")
        if p is not None and p >= 100:
            return "red"  # exhausted, including reserved capacity
        if p is None or ratio is None:
            levels.append(None)
        elif ratio >= PACE_RED:
            return "red"
        elif ratio >= PACE_YELLOW:
            levels.append("yellow")
        else:
            levels.append("green")
    if "yellow" in levels:
        return "yellow"
    if not levels or None in levels:
        return None  # no reliable pace, including the first 2% of a window
    return "green"


def binding(windows):
    cands = [w for w in windows if w.get("percent") is not None]
    if not cands:
        return None
    b = max(cands, key=lambda w: (
        {"red": 3, "yellow": 2, None: 1, "green": 0}[level_for([w])],
        w.get("pace_ratio") or 0, w["percent"]))
    return {"id": b["id"], "label": b["label"], "percent": b["percent"], "headroom_percent": round(100 - b["percent"], 1),
            "resets_in": b.get("resets_in"), "reset_label": b.get("reset_label")}


# ---------------------------------------------------------------- Claude

def claude_token(allow_refresh):
    try:
        with open(CLAUDE_CREDS) as f:
            creds = json.load(f)["claudeAiOauth"]
    except (OSError, KeyError, ValueError) as e:
        return None, None, f"no claude.ai OAuth credentials at {CLAUDE_CREDS} ({e})"
    exp_ms = creds.get("expiresAt") or 0
    refreshed = None
    if exp_ms and exp_ms / 1000 < time.time() + 60 and allow_refresh:
        # Claude Code refreshes and rewrites the file on any authenticated call. Cheapest known: one Haiku word.
        try:
            subprocess.run(["claude", "-p", "reply with the single word ok", "--model", "haiku", "--output-format", "text"],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=120, cwd=CACHE_DIR)
            with open(CLAUDE_CREDS) as f:
                creds = json.load(f)["claudeAiOauth"]
            refreshed = "claude -p haiku"
        except (OSError, subprocess.SubprocessError, KeyError, ValueError) as e:
            return None, creds, f"token expired and refresh failed ({e})"
    return creds.get("accessToken"), creds, refreshed


def read_claude(allow_refresh):
    out = {"vendor": "claude", "status": "unavailable", "source": "oauth_usage", "plan": None, "windows": [], "notes": []}
    token, creds, info = claude_token(allow_refresh)
    if creds:
        out["plan"] = creds.get("subscriptionType")
        out["rate_limit_tier"] = creds.get("rateLimitTier")
    if not token:
        out["notes"].append(info or "no token")
        if creds and not allow_refresh:
            out["notes"].append("token expired; rerun without --no-refresh, or use any claude call to refresh it")
        return out
    if info:
        out["notes"].append(f"token refreshed via {info}")
    req = urllib.request.Request(CLAUDE_USAGE_URL, headers={
        "Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": "orchestration-usage/1 (claude-code companion)"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        out["notes"].append(f"HTTP {e.code} from usage endpoint" + (" (token rejected; rerun to refresh)" if e.code == 401 else ""))
        return out
    except (urllib.error.URLError, TimeoutError, ValueError) as e:
        out["notes"].append(f"usage endpoint unreachable: {e}")
        return out

    windows = []
    shared_windows = []
    hard_stop = False
    limits = data.get("limits")
    if isinstance(limits, list) and limits:
        for i, lim in enumerate(limits):
            kind = lim.get("kind")
            dur = 5 * 3600 if kind == "session" else 7 * 86400 if str(kind).startswith("weekly") else None
            label = {"session": "5-hour", "weekly_all": "weekly all models"}.get(kind, kind)
            scope = (lim.get("scope") or {}).get("model") or {}
            if scope.get("display_name"):
                label = f"weekly {scope['display_name']}"
            wid = kind if kind != "weekly_scoped" else f"weekly_{(scope.get('display_name') or i).__str__().lower()}"
            windows.append(window(wid, label, lim.get("percent"), parse_ts(lim.get("resets_at")), dur,
                                  active=lim.get("is_active"), extra={"severity": lim.get("severity")}))
            scoped = kind == "weekly_scoped" or bool(scope)
            if scoped:
                windows[-1]["bucket"] = scope.get("display_name") or wid
                scoped_level = level_for([windows[-1]], lim.get("severity") in ("exceeded", "critical", "locked"))
                windows[-1]["level"] = scoped_level
                if scoped_level in ("yellow", "red"):
                    out["notes"].append(f"model bucket '{windows[-1]['bucket']}' is {scoped_level}; check eligibility for that model")
            else:
                shared_windows.append(windows[-1])
                if lim.get("severity") in ("exceeded", "critical", "locked"):
                    hard_stop = True
    else:  # older shape
        for key, label, dur in (("five_hour", "5-hour", 5 * 3600), ("seven_day", "weekly all models", 7 * 86400),
                                ("seven_day_opus", "weekly Opus", 7 * 86400), ("seven_day_sonnet", "weekly Sonnet", 7 * 86400)):
            v = data.get(key)
            if isinstance(v, dict) and v.get("utilization") is not None:
                windows.append(window(key, label, v["utilization"], parse_ts(v.get("resets_at")), dur))
                if key in ("seven_day_opus", "seven_day_sonnet"):
                    windows[-1]["bucket"] = key
                    windows[-1]["hard_stop"] = bool(v.get("locked_reason"))
                    windows[-1]["level"] = level_for([windows[-1]], bool(v.get("locked_reason")))
                    if windows[-1]["level"] in ("yellow", "red"):
                        out["notes"].append(f"model bucket '{key}' is {windows[-1]['level']}; check eligibility for that model")
                else:
                    shared_windows.append(windows[-1])
                    if v.get("locked_reason"):
                        hard_stop = True
    xu = data.get("extra_usage") or {}
    out["extra_usage"] = {"enabled": bool(xu.get("is_enabled")), "utilization": xu.get("utilization"),
                          "monthly_limit": xu.get("monthly_limit"), "used_credits": xu.get("used_credits"),
                          "disabled_reason": xu.get("disabled_reason")}
    out["windows"] = windows
    out["binding"] = binding(shared_windows)
    out["hard_stop"] = hard_stop
    out["level"] = level_for(shared_windows, hard_stop)
    out["status"] = "ok" if windows else "unavailable"
    if not windows:
        out["notes"].append("usage endpoint returned no limits (API-key or gateway auth has no plan windows)")
    return out


# ---------------------------------------------------------------- Codex

def codex_rpc_rate_limits(timeout=25):
    msgs = [{"jsonrpc": "2.0", "id": 1, "method": "initialize",
             "params": {"clientInfo": {"name": "orchestration-usage", "title": "orchestration usage", "version": "1"}}},
            {"jsonrpc": "2.0", "id": 2, "method": "account/rateLimits/read", "params": {}}]
    p = subprocess.Popen(["codex", "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True)
    try:
        p.stdin.write("".join(json.dumps(m) + "\n" for m in msgs))
        p.stdin.flush()
        deadline = time.time() + timeout
        buf = ""
        while time.time() < deadline:
            r, _, _ = select.select([p.stdout], [], [], max(0.05, deadline - time.time()))
            if not r:
                break
            chunk = os.read(p.stdout.fileno(), 65536).decode("utf-8", "replace")
            if not chunk:
                break
            buf += chunk
            while "\n" in buf:
                line, buf = buf.split("\n", 1)
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if msg.get("id") == 2:
                    if "error" in msg:
                        raise RuntimeError(msg["error"])
                    return msg["result"]
        raise TimeoutError("no rateLimits response from codex app-server")
    finally:
        p.kill()


def codex_last_snapshot():
    """Fallback: the most recent token_count event in local Codex sessions (snake_case shape)."""
    files = sorted(glob.glob(os.path.join(CODEX_HOME, "sessions", "*", "*", "*", "*.jsonl")), key=os.path.getmtime, reverse=True)
    for path in files[:20]:
        last = None
        try:
            with open(path, errors="replace") as f:
                for line in f:
                    if '"rate_limits"' in line:
                        last = line
        except OSError:
            continue
        if last:
            try:
                ev = json.loads(last)
            except ValueError:
                continue
            payload = ev.get("payload", ev)
            rl = payload.get("rate_limits")
            if rl:
                return rl, ev.get("timestamp"), path
    return None, None, None


def bucket_windows(rl, g, prefix="codex", suffix=""):
    """The primary/secondary windows of one Codex limit bucket."""
    windows = []
    for key, label in (("primary", "primary (short)"), ("secondary", "secondary (weekly)")):
        w = rl.get(key)
        if isinstance(w, dict):
            mins = g(w, "windowDurationMins", "window_minutes") or g(w, "windowDurationMins", "window_duration_mins")
            dur = mins * 60 if mins else None
            lab = label
            if mins:
                lab = f"{int(mins/60)}-hour" if mins < 1440 * 2 else f"{round(mins/1440)}-day"
            windows.append(window(f"{prefix}_{key}", lab + suffix, g(w, "usedPercent", "used_percent"),
                                  parse_ts(g(w, "resetsAt", "resets_at")), dur))
    return windows


def norm_codex(rl, camel, by_id=None, ordinary_allowed=None, reset_credits=None):
    """Normalise either the app-server (camelCase) or session-log (snake_case) rate-limit object.

    by_id, ordinary_allowed and reset_credits come only from the app-server response.
    """
    def g(obj, camel_key, snake_key):
        if not isinstance(obj, dict):
            return None
        return obj.get(camel_key if camel else snake_key)

    windows = bucket_windows(rl, g)
    # Plus/Pro accounts can carry extra per-model buckets beside the default one. They are
    # reported, but only the default bucket sets the level: a spent model bucket leaves the rest usable.
    default_id = g(rl, "limitId", "limit_id")
    extra_windows, bucket_notes = [], []
    for bid, b in (by_id or {}).items():
        if not isinstance(b, dict) or bid == default_id:
            continue
        name = g(b, "limitName", "limit_name") or bid
        bw = bucket_windows(b, g, prefix=f"codex_{bid}", suffix=f" ({name})")
        for w in bw:
            w["bucket"] = bid
        extra_windows += bw
        lvl = level_for(bw, bool(g(b, "rateLimitReachedType", "rate_limit_reached_type")))
        if lvl in ("yellow", "red"):
            bucket_notes.append(f"bucket '{name}' is {lvl}; models limited by it may be unavailable")
    il = g(rl, "individualLimit", "individual_limit")
    individual = None
    if isinstance(il, dict):
        try:
            limit, used = float(il.get("limit")), float(il.get("used"))
            pct = used / limit * 100 if limit else None
        except (TypeError, ValueError):
            limit = used = pct = None
        resets = parse_ts(g(il, "resetsAt", "resets_at"))
        individual = {"limit": limit, "used": used, "remaining_percent": g(il, "remainingPercent", "remaining_percent"),
                      "resets_at": iso(resets) if resets else None}
        # Window length is unknown (monthly in practice); use the reset to estimate 30 days.
        windows.append(window("codex_individual", "individual limit", pct, resets, 30 * 86400,
                              extra={"pace_basis": "estimated 30-day window ending at reset"}))
    credits = rl.get("credits") or {}
    has_credits = g(credits, "hasCredits", "has_credits")
    reached = g(rl, "rateLimitReachedType", "rate_limit_reached_type")
    spend_stop = bool(g(rl, "spendControlReached", "spend_control_reached"))
    hard_stop = (bool(reached) or spend_stop or ordinary_allowed is False
                 or (bool(credits) and has_credits is False and not windows))
    resets = None
    if isinstance(reset_credits, dict):
        avail = [c for c in reset_credits.get("credits") or [] if c.get("status") == "available"]
        exp = sorted(t for t in (parse_ts(c.get("expiresAt")) for c in avail) if t)
        resets = {"available": reset_credits.get("availableCount", len(avail)),
                  "next_expires_at": iso(exp[0]) if exp else None}
    level, bind = level_for(windows, hard_stop), binding(windows)
    return {
        "plan": g(rl, "planType", "plan_type"),
        "windows": windows + extra_windows,
        "bucket_notes": bucket_notes,
        "individual_limit": individual,
        "credits": {"has_credits": has_credits, "unlimited": credits.get("unlimited"),
                    "balance": (lambda b: float(b) if b not in (None, "") else None)(credits.get("balance"))} if credits else None,
        "hard_stop": hard_stop,
        "rate_limit_reached_type": reached,
        "spend_control_reached": spend_stop,
        "ordinary_usage_allowed": ordinary_allowed,
        "reset_credits": resets,
        "binding": bind,
        "level": level,
    }


def read_codex():
    out = {"vendor": "codex", "status": "unavailable", "source": None, "plan": None, "windows": [], "notes": []}
    try:
        res = codex_rpc_rate_limits()
        rl = res.get("rateLimits") or {}
        out.update(norm_codex(rl, camel=True, by_id=res.get("rateLimitsByLimitId"),
                              ordinary_allowed=res.get("ordinaryUsageAllowed"),
                              reset_credits=res.get("rateLimitResetCredits")))
        out["notes"] += out.pop("bucket_notes")
        if res.get("ordinaryUsageAllowed") is False:
            out["notes"].append("Codex reports ordinary usage not allowed")
        out["source"] = "app-server account/rateLimits/read"
        out["status"] = "ok"
        return out
    except (OSError, RuntimeError, TimeoutError, KeyError, ValueError) as e:
        out["notes"].append(f"app-server query failed: {e}")
    rl, ts, path = codex_last_snapshot()
    if rl:
        out.update(norm_codex(rl, camel=False))
        out.pop("bucket_notes")
        out["source"] = f"stale session log {os.path.basename(path)}"
        out["status"] = "stale"
        out["snapshot_at"] = ts
        out["notes"].append("values are from the last Codex turn on this machine, not live")
    else:
        out["notes"].append("no local Codex session with rate-limit data either")
    return out


# ---------------------------------------------------------------- Gemini

# agy groups its quota by model family. Only the Gemini groups are the Gemini vendor; the
# "Claude and GPT models" group is Anthropic and OpenAI models served through agy.
GEMINI_LEVEL_GROUPS = ("gemini models",)
WINDOW_SECONDS = {"5h": 5 * 3600, "weekly": 7 * 86400}


def agy_command(cmd, timeout=60):
    """A read-only slash command in print mode: no agent turn, no quota spent, no conversation kept."""
    p = subprocess.run(["agy", "-p", cmd, "--output-format", "json"], stdin=subprocess.DEVNULL,
                       capture_output=True, text=True, timeout=timeout, cwd=CACHE_DIR)
    if p.returncode != 0:
        raise RuntimeError(f"agy -p {cmd} exited {p.returncode}: {(p.stderr or p.stdout).strip()[:200]}")
    return (json.loads(p.stdout).get("command") or {}).get("data") or {}


def read_gemini():
    out = {"vendor": "gemini", "status": "unavailable", "source": None, "plan": None, "windows": [], "notes": []}
    try:
        data = agy_command("/usage")
    except (OSError, RuntimeError, subprocess.SubprocessError, ValueError) as e:
        out["notes"].append(f"agy usage query failed: {e}")
        return out
    windows, extra = [], []
    for grp in data.get("groups") or []:
        gname = grp.get("name") or "?"
        counts = gname.lower() in GEMINI_LEVEL_GROUPS
        bw = []
        for b in grp.get("buckets") or []:
            frac = b.get("remaining_fraction")
            used = None if frac is None else (1 - float(frac)) * 100
            label = f"{'5-hour' if b.get('window') == '5h' else b.get('window') or '?'} ({gname})"
            w = window(f"gemini_{b.get('id')}", label, used, parse_ts(b.get("reset_time")),
                       WINDOW_SECONDS.get(b.get("window")))
            if not counts:
                w["bucket"] = gname
            bw.append(w)
        if counts:
            windows += bw
        else:
            extra += bw
            lvl = level_for(bw)
            if lvl in ("yellow", "red"):
                out["notes"].append(f"agy group '{gname}' is {lvl}; models limited by it may be unavailable")
    try:
        cr = agy_command("/credits")
        out["credits"] = {"balance": cr.get("remaining_credits")}
    except (OSError, RuntimeError, subprocess.SubprocessError, ValueError):
        out["credits"] = None
    out["windows"] = windows + extra
    out["binding"] = binding(windows)
    out["level"] = level_for(windows)
    out["source"] = "agy -p /usage"
    out["status"] = "ok" if windows else "unavailable"
    if not windows:
        out["notes"].append("agy reported no Gemini quota group (signed out, or an API-key / Cloud project sign-in)")
    return out


# ---------------------------------------------------------------- Cursor / shared Grok pool

GROK_BILLING_URL = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"


def grok_token():
    path = os.path.join(os.path.expanduser(os.environ.get("GROK_HOME", "~/.grok")), "auth.json")
    with open(path) as f:
        accounts = json.load(f)
    tokens = [a["key"] for a in accounts.values() if isinstance(a, dict) and a.get("key")]
    if len(tokens) != 1:
        raise ValueError("Grok auth must contain exactly one account to identify the shared pool")
    return tokens[0]


def refresh_grok_token():
    """Initialize the CLI to refresh OAuth without submitting a model prompt."""
    p = subprocess.Popen(["grok", "agent", "stdio"], stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        p.stdin.write((json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                                  "params": {"protocolVersion": 1, "clientCapabilities": {}}}) + "\n").encode())
        p.stdin.flush()
        deadline = time.monotonic() + 8
        buf = b""
        while time.monotonic() < deadline:
            ready, _, _ = select.select([p.stdout], [], [], max(0, deadline - time.monotonic()))
            if not ready:
                break
            chunk = os.read(p.stdout.fileno(), 65536)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    if json.loads(line).get("id") == 1:
                        return
                except (ValueError, AttributeError):
                    continue
        raise RuntimeError("Grok token refresh timed out or exited before initialization")
    finally:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        p.wait()
        p.stdin.close()
        p.stdout.close()


def grok_billing():
    req = urllib.request.Request(GROK_BILLING_URL, headers={
        "Authorization": f"Bearer {grok_token()}", "X-XAI-Token-Auth": "xai-grok-cli",
        "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as response:
        return json.load(response)


def read_cursor(allow_refresh=True):
    """Read the shared Cursor/Grok plan pool directly, without a terminal UI."""
    out = {"vendor": "cursor", "status": "unavailable", "source": "Grok billing API (shared Cursor/Grok pool)",
           "plan": None, "windows": [], "notes": []}
    try:
        try:
            data = grok_billing()
        except urllib.error.HTTPError as e:
            if e.code not in (401, 403) or not allow_refresh:
                raise
            refresh_grok_token()
            data = grok_billing()
        config = data.get("config") or {}
        percent = config.get("creditUsagePercent")
        if isinstance(percent, bool) or not isinstance(percent, (int, float)) or not math.isfinite(percent) or percent < 0:
            raise ValueError("shared pool usage is missing or invalid")
        period = config.get("currentPeriod") or {}
        start, end = parse_ts(period.get("start")), parse_ts(period.get("end"))
        duration = (end - start).total_seconds() if start and end and end > start else None
        label = "weekly shared Grok/Cursor" if period.get("type") == "USAGE_PERIOD_TYPE_WEEKLY" else "shared Grok/Cursor"
        out["windows"] = [window("shared", label, percent, end, duration,
                                 extra={"starts_at": iso(start) if start else None})]
        out["binding"] = binding(out["windows"])
        out["level"] = level_for(out["windows"])
        out["status"] = "ok"
    except (OSError, ValueError, RuntimeError, TypeError, AttributeError, subprocess.SubprocessError) as e:
        out["notes"].append(f"Grok billing read failed: {e}")
    return out


# ---------------------------------------------------------------- advice

VENDORS = ("claude", "codex", "gemini", "cursor")
VENDOR_COMMANDS = {"claude": "claude", "codex": "codex", "gemini": "agy", "cursor": "cursor-agent"}
LEVEL_RANK = {"green": 0, "yellow": 1, "red": 2, None: 1}  # unknown counts as yellow


POLICY_FILE = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "usage-policy.json")
POLICY_KEYS = {"ignore_pace", "prefer", "allow_credits", "reserve_percent"}


def load_policy(path):
    try:
        with open(path) as f:
            policy = json.load(f)
    except FileNotFoundError:
        return {}
    if not isinstance(policy, dict) or set(policy) - set(VENDORS):
        raise ValueError("policy must map vendor names (claude, codex, gemini, cursor) to options")
    for vendor, options in policy.items():
        if (not isinstance(options, dict) or set(options) - POLICY_KEYS
                or any(type(value) is not bool for key, value in options.items() if key != "reserve_percent")):
            raise ValueError(f"invalid policy for {vendor}: use boolean ignore_pace, prefer, allow_credits")
        reserve = options.get("reserve_percent", 0)
        if type(reserve) not in (int, float) or not math.isfinite(reserve) or not 0 <= reserve <= 100:
            raise ValueError(f"invalid reserve_percent for {vendor}: use a number from 0 to 100")
    return policy


def apply_policy(vendors, policy):
    """Policy changes routing advice, never the cached measurements."""
    for name, d in vendors.items():
        opts = {key: policy.get(name, {}).get(key, 0 if key == "reserve_percent" else False) for key in sorted(POLICY_KEYS)}
        # Rebuild copies from actual values so cached data and repeated applications stay raw.
        adjusted = []
        for original in d.get("windows", []):
            w = dict(original)
            actual = w.get("actual_percent", w.get("percent"))
            reserve = opts["reserve_percent"]
            percent = None if actual is None else min(100, actual + reserve) if reserve else actual
            timing = window(w.get("id", "quota"), w.get("label", "quota"), percent, parse_ts(w.get("resets_at")),
                            w.get("window_hours") * 3600 if w.get("window_hours") else None)
            w.update(timing)
            w["actual_percent"] = actual
            w["reserve_percent"] = reserve
            if w.get("bucket"):
                w["level"] = level_for([w], w.get("severity") in ("exceeded", "critical", "locked") or w.get("hard_stop", False))
            adjusted.append(w)
        if adjusted:
            d["windows"] = adjusted
            shared = [w for w in adjusted if not w.get("bucket")]
            d["level"] = level_for(shared, d.get("hard_stop", False))
            d["binding"] = binding(shared)
        d["policy"] = opts
        d["routing_level"] = d.get("level")
        d["policy_notes"] = []
        if not any(opts.values()):
            continue
        if d.get("status") != "ok":
            d["policy_notes"].append("override cannot establish availability from stale or missing quota")
            continue
        blocked = (d.get("hard_stop") or d.get("spend_control_reached")
                   or d.get("ordinary_usage_allowed") is False or d.get("rate_limit_reached_type"))
        if blocked:
            d["routing_level"] = "red"
            d["policy_notes"].append("service block or spending limit remains in effect")
            continue
        windows = [w for w in d.get("windows", []) if not w.get("bucket")]
        exhausted = any((w.get("percent") or 0) >= 100 for w in windows)
        credits = d.get("credits") or {}
        credit_ready = (name == "codex" and opts["allow_credits"]
                        and d.get("ordinary_usage_allowed") is True
                        and credits.get("has_credits") is True
                        and (credits.get("unlimited") is True or (credits.get("balance") or 0) > 0))
        if exhausted and credit_ready:
            d["routing_level"] = "green"
            d["policy_notes"].append("included quota exhausted; existing credits authorized and service allows usage")
        elif opts["ignore_pace"] and not exhausted and windows and all(w.get("percent") is not None for w in windows):
            d["routing_level"] = "green"
            d["policy_notes"].append("pace restriction ignored by user policy")
        if opts["allow_credits"]:
            d["policy_notes"].append("existing credits authorized; no purchases, limit increases or reset-credit redemption")
            if name != "codex":
                d["policy_notes"].append("automatic credit availability check unsupported for this vendor; quota exhaustion still blocks routing")


def routing_level(d):
    return d.get("routing_level", d.get("level"))


def advise(vendors):
    installed = {v: d for v, d in vendors.items() if d.get("status") != "not_installed"}
    missing = {v: "not_installed" for v in vendors if v not in installed}
    if not installed:
        return {**missing, "prefer": "neither", "policy_preferred": [],
                "rule": "no selected vendor CLI is installed; no routing candidates", "notes": []}
    advice = advise_installed(installed)
    if missing:
        advice.update(missing)
        advice["rule"] += "; not installed: " + ", ".join(missing)
        if advice["prefer"] in ("either", "n/a") and len(vendors) > 1:
            advice["prefer"] = "+".join(v for v in installed if advice.get(v) != "red") or "neither"
    return advice


def advise_installed(vendors):
    levels = {v: (routing_level(vendors[v]) if vendors[v]["status"] in ("ok", "stale") else None)
              for v in VENDORS if v in vendors}
    notes = []
    for v, lvl in levels.items():
        vd = vendors[v]
        b = vd.get("binding")
        if lvl is None:
            notes.append(f"{v}: quota unknown ({'; '.join(vd.get('notes') or ['not read'])}); treat as yellow")
        elif b:
            pace = next((w.get("pace") for w in vd.get("windows", []) if w["id"] == b["id"]), "n/a")
            reset = (f"resets in {b['resets_in']}" if b.get("resets_in") else
                     f"resets {b['reset_label']}" if b.get("reset_label") else "reset time unknown")
            notes.append(f"{v}: {lvl}; binding window '{b['label']}' at {b['percent']}% used, {reset}, pace {pace}")
    if len(vendors) == 1:  # --vendor: the other side was not read, so no cross-vendor preference
        (v, vd), = vendors.items()
        lvl = routing_level(vd) if vd["status"] in ("ok", "stale") else None
        rule = {"red": f"{v} red: launch no new work on it",
                "yellow": f"{v} yellow: prefer the other vendor where the table allows",
                "green": f"{v} green"}.get(lvl, f"{v} quota unknown: treat as yellow")
        return {v: lvl or "unknown", "prefer": "n/a",
                "rule": rule + "; run without --vendor for a routing preference", "notes": notes}
    lv = list(levels.values())
    best = min(LEVEL_RANK[l] for l in lv)
    greenest = [v for v, l in levels.items() if LEVEL_RANK[l] == best]
    if all(l == "red" for l in lv):
        prefer, rule = "neither", "every vendor red: stop launching new work and tell the user"
    elif all(l is None for l in lv):
        prefer, rule = "either", "quota unknown for every vendor: route by fit, say so in the record, and re-run usage before large launches"
    elif len(greenest) == len(levels):
        prefer, rule = "either", "choose the least expensive suitable model; green is availability, not a reason to upgrade"
    else:
        prefer = "+".join(greenest)
        names = " or ".join(v.capitalize() for v in greenest)
        reds = [v for v, l in levels.items() if l == "red"]
        rule = f"choose the least expensive suitable model; among suitable candidates prefer capacity on {names}"
        if reds:
            rule += f"; no new work on {', '.join(reds)}"
    preferred = [v for v in greenest if vendors[v].get("policy", {}).get("prefer")
                 and levels[v] == "green" and vendors[v].get("status") == "ok"]
    if preferred:
        prefer = "+".join(greenest)
        rule += "; user policy favors " + "+".join(preferred) + " among suitable choices; other listed vendors remain eligible"
    res = {v: (l or "unknown") for v, l in levels.items()}
    res.update({"prefer": prefer, "policy_preferred": preferred, "rule": rule, "notes": notes})
    return res


def text_report(snap):
    lines = [f"usage snapshot {snap['generated_at']}" + (" (cached)" if snap.get("from_cache") else "")]
    for v in VENDORS:
        d = snap["vendors"].get(v)
        if not d:
            continue
        head = f"{v:6s} {d['status']:11s} plan={d.get('plan')} level={d.get('level', '-')} via {d.get('source')}"
        head += f"; observed {d.get('observed_at', 'unknown')} (age {d.get('age_seconds', 'unknown')}s)"
        if "routing_level" in d:
            head += f"; routing={d['routing_level'] or 'unknown'}"
        lines.append(head)
        enabled = [f"{k}={value}" if k == "reserve_percent" else k for k, value in d.get("policy", {}).items() if value]
        if enabled:
            lines.append("   policy: " + ", ".join(enabled))
        for note in d.get("policy_notes", []):
            lines.append("   policy: " + note)
        for w in d.get("windows", []):
            pct = "  -- " if w["percent"] is None else f"{w['percent']:5.1f}%"
            if w.get("reserve_percent") and w.get("actual_percent") is not None:
                pct += f" routing (actual {w['actual_percent']}%, +{w['reserve_percent']}pp reserve)"
            exp = f" (expected {w['expected_percent_now']}%, {w['pace']})" if w.get("expected_percent_now") is not None else ""
            reset = (f"resets in {w['resets_in']}" if w.get("resets_in") else
                     f"resets {w['reset_label']}" if w.get("reset_label") else "reset time unknown")
            lines.append(f"   {w['label']:<22s}{pct}  {reset}{exp}")
        if d.get("on_demand"):
            od = d["on_demand"]
            lines.append(f"   on-demand              ${od['used']:g} / ${od['limit']:g}")
        if d.get("credits") and d["credits"].get("balance") is not None:
            lines.append(f"   credits balance        {d['credits']['balance']:.2f}")
        rc = d.get("reset_credits")
        if rc and rc.get("available"):
            lines.append(f"   free limit resets      {rc['available']} available (next expires {rc['next_expires_at']})")
        for n in d.get("notes", []):
            lines.append(f"   note: {n}")
    a = snap["advice"]
    levels = " ".join(f"{v}={a[v]}" for v in VENDORS if v in a)
    lines.append(f"advice: {levels} prefer={a['prefer']} -> {a['rule']}")
    return "\n".join(lines)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--vendor", choices=[*VENDORS, "all"], default="all")
    ap.add_argument("--text", action="store_true", help="human summary instead of JSON")
    ap.add_argument("--no-refresh", action="store_true", help="do not refresh Claude/Grok tokens")
    ap.add_argument("--no-cache", action="store_true", help="always query live")
    ap.add_argument("--cache-ttl", type=int, default=CACHE_TTL, help="seconds a successful vendor read is reused (default 900)")
    ap.add_argument("--policy", default=POLICY_FILE, help="vendor override JSON (default: usage-policy.json in skill directory)")
    args = ap.parse_args()
    try:
        policy = load_policy(args.policy)
    except (OSError, ValueError) as e:
        ap.error(f"cannot read usage policy: {e}")
    def progress(message):
        if args.text:
            print(f"usage: {message}", file=sys.stderr, flush=True)

    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)

    def collect(prev):
        if prev.get("cache_version") != CACHE_VERSION:
            prev = {}
        saved = prev.get("vendors", {}) if isinstance(prev.get("vendors"), dict) else {}
        epochs = prev.get("vendor_epochs", {}) if isinstance(prev.get("vendor_epochs"), dict) else {}
        now = time.time()
        vendors = {}
        cached = []
        pending = []
        readers = {"claude": lambda: read_claude(allow_refresh=not args.no_refresh),
                   "codex": read_codex, "gemini": read_gemini, "cursor": lambda: read_cursor(allow_refresh=not args.no_refresh)}
        for name in VENDORS if args.vendor == "all" else (args.vendor,):
            command = VENDOR_COMMANDS[name]
            if shutil.which(command) is None:
                vendors[name] = {"vendor": name, "status": "not_installed", "windows": [],
                                 "notes": [f"{command} not found on PATH; skipped"]}
                saved.pop(name, None)
                epochs[name] = now
                progress(f"{name}: not installed ({command}); skipped")
                continue
            old = saved.get(name)
            fetched = epochs.get(name, prev.get("generated_epoch", 0))
            ttl = args.cache_ttl if isinstance(old, dict) and old.get("status") == "ok" else FAILURE_TTL
            reset_passed = any(
                fetched < parse_ts(w.get("resets_at")).timestamp() <= now
                for w in (old or {}).get("windows", []) if w.get("resets_at") and parse_ts(w.get("resets_at"))
            ) if isinstance(old, dict) else False
            if (not args.no_cache and isinstance(old, dict) and isinstance(fetched, (int, float))
                    and 0 <= now - fetched < ttl and not reset_passed):
                vendors[name] = dict(old)
                cached.append(name)
                progress(f"{name}: using cached result")
            else:
                pending.append(name)
        # Only cache misses perform I/O. The process lock still deduplicates other callers.
        if pending:
            with ThreadPoolExecutor(max_workers=len(pending)) as pool:
                futures = {}
                for name in pending:
                    progress(f"{name}: reading quota" + (" (shared Grok billing API)" if name == "cursor" else ""))
                    futures[pool.submit(readers[name])] = name
                for future in as_completed(futures):
                    name = futures[future]
                    try:
                        vendors[name] = future.result()
                    except Exception as e:
                        vendors[name] = {"vendor": name, "status": "unavailable", "windows": [],
                                         "notes": [f"quota reader failed: {type(e).__name__}: {e}"]}
                    progress(f"{name}: {vendors[name]['status']}")
                    epochs[name] = time.time()
                    saved[name] = dict(vendors[name])
        # Stable output order regardless of completion order.
        vendors = {name: vendors[name] for name in VENDORS if name in vendors}
        for name, vendor in vendors.items():
            fetched = epochs.get(name, prev.get("generated_epoch", 0))
            vendor["observed_at"] = iso(dt.datetime.fromtimestamp(fetched, dt.timezone.utc))
            vendor["age_seconds"] = max(0, round(time.time() - fetched))
        apply_policy(vendors, policy)
        snap = {"generated_at": iso(now_utc()), "generated_epoch": time.time(),
                "vendors": vendors, "advice": advise(vendors)}
        if cached:
            snap["from_cache"] = True
            snap["cached_vendors"] = cached
        return snap, {"cache_version": CACHE_VERSION, "vendors": saved, "vendor_epochs": epochs}

    # Serialize collection batches across processes; vendors within each batch run concurrently.
    with open(CACHE_LOCK, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            progress("waiting for another usage process to finish")
            fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(CACHE_FILE) as f:
                prev = json.load(f)
            if not isinstance(prev, dict):
                prev = {}
        except (OSError, ValueError):
            prev = {}
        snap, cache = collect(prev)
        tmp = f"{CACHE_FILE}.{os.getpid()}.tmp"
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w") as f:
                json.dump(cache, f, indent=1)
            os.replace(tmp, CACHE_FILE)
        except OSError:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    print(text_report(snap) if args.text else json.dumps(snap, indent=2))
    ok = any(v["status"] in ("ok", "stale") for v in snap["vendors"].values())
    sys.exit(0 if ok else 2)


if __name__ == "__main__":
    main()
